PORT=8101
DATABASE_URL=postgres://platform:REPLACE_ME_DB_PASSWORD@REPLACE_ME_DB_HOST:5432/rag_service?sslmode=require
KAFKA_BROKERS=REPLACE_ME_KAFKA_BROKERS

# Distributed tracing (Observability Fase 3) -- OTLP/HTTP collector endpoint (Jaeger or equivalent).
OTLP_ENDPOINT=REPLACE_ME_OTLP_ENDPOINT

# Folder dokumentasi yang di-index. Di container harus di-mount (lihat
# volumeMounts di infra/kubernetes/base/rag-service.yaml); tanpa mount,
# POST /ingest menjawab 424 sambil menyebut path yang dicarinya.
RAG_CORPUS_DIR=/app/corpus

# Kunci API Anthropic. JANGAN ditulis di berkas ini maupun di ConfigMap --
# di K8s dia datang lewat Secret `anthropic-api-key`. Dibiarkan kosong pun
# service tetap jalan: /ask mengembalikan kutipan dokumentasi yang paling
# cocok tanpa jawaban yang disusun model.
ANTHROPIC_API_KEY=

# Model dan kedalaman penalarannya. effort "low" dipilih karena tugasnya
# menyusun jawaban dari kutipan yang sudah disodorkan, bukan memecahkan
# masalah -- dan ini jalur chat yang dipakai berulang kali.
RAG_MODEL=claude-opus-5
RAG_EFFORT=low
RAG_TOP_K=5
